# Release manifests hash these files byte-for-byte. Keep their canonical LF
# representation on every checkout, including Git for Windows with autocrlf.
server/resources/docs/** text eol=lf
server/resources/openmsx/** text eol=lf
.openmsx-home/** text eol=lf
# This file is intentionally stored as DOS-readable ASCII with CRLF bytes.
agent/README.TXT -text whitespace=cr-at-eol
# Generated assembly source is compared byte-for-byte on every platform.
agent/msx_version.inc text eol=lf
