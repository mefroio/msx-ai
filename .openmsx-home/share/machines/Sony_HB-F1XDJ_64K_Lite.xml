<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>Sony</manufacturer>
    <code>HB-F1XDJ 64K Lite</code>
    <release_year>1988</release_year>
    <description>HB-F1XDJ MSX2+ with a built-in disk drive and 64 KiB mapper RAM; optional Kanji and FM-BASIC ROMs are omitted.</description>
    <type>MSX2+</type>
    <region>jp</region>
  </info>

  <RenShaTurbo>
    <min_ints>47</min_ints>
    <max_ints>221</max_ints>
  </RenShaTurbo>

  <CassettePort/>

  <devices>

    <S1985 id="S1985">
      <sramname>hb-f1xdj-64k-lite_s1985.sram</sramname>
    </S1985>

    <PPI id="ppi">
      <sound><volume>16000</volume></sound>
      <io base="0xA8" num="8"/>
      <keyboard_type>jp_jis</keyboard_type>
      <has_keypad>true</has_keypad>
      <key_ghosting_sgc_protected>false</key_ghosting_sgc_protected>
      <code_kana_locks>true</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <version>V9958</version>
      <vram>128</vram>
      <io base="0x98" num="8" type="O"/>
      <io base="0x98" num="8" type="I"/>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <keyboardlayout>JIS</keyboardlayout>
      <sound><volume>21000</volume></sound>
      <io base="0xA0" num="8" type="IO"/>
      <ignorePortDirections>true</ignorePortDirections>
    </PSG>

    <RTC id="Real time clock">
      <sramname>hb-f1xdj-64k-lite.cmos</sramname>
      <io base="0xB4" num="4" type="IO"/>
    </RTC>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="8" type="IO"/>
      <bidirectional>true</bidirectional>
      <unused_bits>0x00</unused_bits>
    </PrinterPort>

    <ResetStatusRegister id="Reset Status register">
      <inverted>true</inverted>
      <io base="0xF4" num="1"/>
    </ResetStatusRegister>

    <primary slot="0">
      <secondary slot="0">
        <ROM id="MSX BIOS with BASIC ROM">
          <rom>
            <filename>f1xjbios.rom</filename>
            <sha1>e2fbd56e42da637609d23ae9df9efd1b4241b18a</sha1>
          </rom>
          <mem base="0x0000" size="0x8000"/>
        </ROM>
      </secondary>

      <secondary slot="1"/>
      <secondary slot="2"/>

      <secondary slot="3">
        <ROM id="HB-F1XDJ MSX-JE">
          <rom>
            <filename>f1xjfirm.rom</filename>
            <sha1>ade0c5ba5574f8114d7079050317099b4519e88f</sha1>
          </rom>
          <mem base="0x0000" size="0x10000"/>
          <sramname>hb-f1xdj-64k-lite_msx-je.sram</sramname>
          <mappertype>Halnote</mappertype>
        </ROM>
      </secondary>
    </primary>

    <primary external="true" slot="1"/>
    <primary external="true" slot="2"/>

    <primary slot="3">
      <secondary slot="0">
        <MemoryMapper id="Main RAM">
          <size>64</size>
          <mem base="0x0000" size="0x10000"/>
          <initialContent encoding="gz-base64">eNpj+M8wouEI9z4DAJBx/wE=</initialContent>
        </MemoryMapper>
      </secondary>

      <secondary slot="1">
        <ROM id="MSX Sub ROM">
          <rom>
            <filename>f1xjext.rom</filename>
            <sha1>fe0254cbfc11405b79e7c86c7769bd6322b04995</sha1>
          </rom>
          <mem base="0x0000" size="0x4000"/>
        </ROM>
      </secondary>

      <secondary slot="2">
        <WD2793 id="Memory Mapped FDC">
          <connectionstyle>Sony</connectionstyle>
          <motor_off_timeout_ms>4000</motor_off_timeout_ms>
          <drives>1</drives>
          <rom>
            <filename>f1xjdisk.rom</filename>
            <sha1>c1bb307a570ab833e3bfcc4a58a4f4e12dc1df0f</sha1>
          </rom>
          <mem base="0x4000" size="0x4000"/>
          <rom_visibility base="0x4000" size="0x4000"/>
        </WD2793>
      </secondary>

      <secondary slot="3"/>
    </primary>

  </devices>
</msxconfig>
