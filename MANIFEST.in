include LICENSE
include AUTHORS.md
include README.md
include TECHNICAL.md
include Makefile
exclude .mcp.json

recursive-include agent *.asm *.inc *.md
recursive-include assets *.png *.md
recursive-include server/resources *.md *.json
recursive-include server/resources/openmsx *.xml README
recursive-include tests *.py
recursive-include third_party/memman *.b64 NOTICE SHA256SUMS
recursive-include third_party/openmsx NOTICE GPL-2.0.txt
recursive-include tools *.py *.tcl

prune work
prune .openmsx-home
prune .openmsx-home/persistent
prune .openmsx-home/recordings
prune .openmsx-home/replays
prune .openmsx-home/savestates
prune .openmsx-home/screenshots
prune .openmsx-home/setups
prune .openmsx-home/share/systemroms

global-exclude .DS_Store
global-exclude *.py[cod]
