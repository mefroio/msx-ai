  Modified by MSX-AI through 2026-08-07 for isolated firmware-independent
  test profiles and mapper-size variants.
  See third_party/openmsx/NOTICE and GPL-2.0.txt for origin and license.
-->
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>Gradiente</manufacturer>
    <code>Expert 2.0 64K test profile</code>
    <release_year>1988</release_year>
    <description>Gradiente Expert 2.0 test profile with 64 KiB mapper RAM. A disk interface can be attached separately.</description>
    <type>MSX2</type>
    <region>br</region>
  </info>

  <MapperReadBackBits>largest</MapperReadBackBits>

  <CassettePort/>

  <devices>

    <S1985 id="S1985">
      <sramname>expert20_ddx_s1985.sram</sramname>
    </S1985>

    <PPI id="ppi">
      <has_keypad>false</has_keypad>
      <sound>
        <volume>16000</volume>
      </sound>
      <io base="0xA8" num="4"/>
      <keyboard_type>br_gradiente_1_1</keyboard_type>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <version>V9938</version>
      <vram>128</vram>
      <io base="0x98" num="8" type="O"/> <!-- S1985 mirrors ports 0x98-0x9F -->
      <io base="0x98" num="8" type="I"/>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <sound>
        <volume>21000</volume>
      </sound>
      <io base="0xA0" num="4" type="IO"/>
      <ignorePortDirections>true</ignorePortDirections>
    </PSG>

    <RTC id="Real time clock">
      <sramname>expert20_ddx.cmos</sramname>
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
    </RTC>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <rom>
          <filename>exp20bios.rom</filename>
          <sha1>9c43106dba3ae2829e9a11dffa9d000ed6d6454c</sha1>
        </rom>
        <mem base="0x0000" size="0x8000"/>
      </ROM>
    </primary>

    <primary external="true" slot="1"/>

    <primary external="true" slot="2"/>

    <primary slot="3">

      <secondary slot="0">
        <ROM id="MSX Sub ROM">
          <rom>
            <filename>exp20sub.rom</filename>
            <sha1>4f2a7e0172f0214f025f23845f6e053d0ffd28e8</sha1>
          </rom>
          <mem base="0x0000" size="0x4000"/>
        </ROM>
      </secondary>

      <secondary slot="1"/>

      <secondary slot="2">
        <MemoryMapper id="Main RAM">
          <size>64</size>
          <mem base="0x0000" size="0x10000"/>
        </MemoryMapper>
      </secondary>

      <secondary slot="3"/>

    </primary>

  </devices>

</msxconfig>
